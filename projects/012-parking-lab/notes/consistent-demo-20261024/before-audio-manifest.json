  "languageBoost": "Chinese",
  "clips": {
    "judgment_intro": {
      "file": "audio/minimax/judgment_intro-9c8d1a94099f.mp3",
      "text": "先看同一面镜中，车身和库侧线的关系，再核对另一侧。辨认辅助用青色描出可见车身参照，金色标出库侧线。库底的横线不用于判断入库方向。这段示范演到前轮回正就停，再由你判断时机。",
      "sha256": "508687e908d19741129b6390ba385f188ee9f266c06de4313c124683b319f030",
      "bytes": 361140,
      "duration": 22.464
    },
    "intro": {
      "file": "audio/minimax/intro-93f4e99af3c2.mp3",
      "text": "先调整座椅和左右后视镜，让车身和地面边线都能看清。本示范用于理解 C 一倒车入库，实际点位请以你的教练车和教练指导为准。",
      "sha256": "363c51c9b7a65db30064b1dc7f0279ff57ebb3ebf70331a863f07a9e683bede1",
      "bytes": 239604,
      "duration": 14.868
    },
    "straight": {
      "file": "audio/minimax/straight-ee47a4a2b57e.mp3",
      "text": "保持方向回正，按住 S 慢速直倒。先认右镜里的车身和侧后地面，库线进入镜面后再比较间隙；接近模型参照时准备转向。",
      "sha256": "3866392e205d17ee6931690536bb59ea5b22b5385757b15b06ea30adf35e410e",
      "bytes": 245364,
      "duration": 15.228
    },
    "prepare_right": {
      "file": "audio/minimax/prepare_right-9a8f9e1e98ed.mp3",
      "text": "看右镜，直倒，准备右转。",
      "sha256": "578a37e84de95f61d676410e4762842d134b6b699d68c93fca404519855f7949",
      "bytes": 52980,
      "duration": 3.204
    },
    "prepare_left": {
      "file": "audio/minimax/prepare_left-49c3723f61fe.mp3",
      "text": "看左镜，直倒，准备左转。",
      "sha256": "752ed292b04d98d034e8c964f9ffeb75fb7b0c82d3f5174be7a565ed5d926cd6",
      "bytes": 58740,
      "duration": 3.564
    },
    "right_turn": {
      "file": "audio/minimax/right_turn-3ffc6e96a4b7.mp3",
      "text": "右打方向。",
      "sha256": "a9d0b5b3107512239f2eb4d988855651c3ff2dfe11abbfa6cc6bafafa2ac0928",
      "bytes": 21300,
      "duration": 1.224
    },
    "hold_right": {
      "file": "audio/minimax/hold_right-c5f75d834f1f.mp3",
      "text": "方向已到位，保持当前转角。先认右镜中的车身和侧后地面，库角进入镜面后再比较间隙，兼顾左镜。",
      "sha256": "b56fb0acb9949c1497a325d6a0c1a5dddb7017ad878c14615a136f3cd895b424",
      "bytes": 199860,
      "duration": 12.384
    },
    "hold_left": {
      "file": "audio/minimax/hold_left-647c56b2a953.mp3",
      "text": "方向已到位，保持当前转角。先认左镜中的车身和侧后地面，库角进入镜面后再比较间隙，兼顾右镜。",
      "sha256": "c872b38613352bd9b5a7974368f127db444f197b720a3cdbcb035684c7dea60d",
      "bytes": 198708,
      "duration": 12.312
    },
    "right_align": {
      "file": "audio/minimax/right_align-43e24bee1873.mp3",
      "text": "保持当前转角，低速倒车。先认右镜中的车身和侧后地面，库角进入镜面后再比较间隙，兼顾左镜。",
      "sha256": "8bd084d56b260eaea1dfd2d9ae1fe4d89a6888ac3ee4655afcf52934ead3a6a3",
      "bytes": 190068,
      "duration": 11.772
    },
    "prepare_center_right": {
      "file": "audio/minimax/prepare_center_right-bf3372bfba1b.mp3",
      "text": "看右镜、左镜，准备回正。",
      "sha256": "b9c2ba73ac0838eaa96b1b38bf5389a55f97772f943713fd199f9a316b41ab25",
      "bytes": 53556,
      "duration": 3.24
    },
    "prepare_center_left": {
      "file": "audio/minimax/prepare_center_left-0ef5ea7975ab.mp3",
      "text": "看左镜、右镜，准备回正。",
      "sha256": "32a271054a85da82fddfc4c76ffb90c7f645a4d9ee51e2afb0be644c79c5af5a",
      "bytes": 47220,
      "duration": 2.844
    },
    "center": {
      "file": "audio/minimax/center-8d4cf5778192.mp3",
      "text": "回正。",
      "sha256": "8a66840010d68a2fbb66513c75a730986f2bb2698f4ab17fa6a5b3facbe1bc28",
      "bytes": 16692,
      "duration": 0.936
    },
    "park": {
      "file": "audio/minimax/park-dc30d8c1b2e8.mp3",
      "text": "方向回正后继续慢速直倒，左右镜确认间距。车身全部入库，车尾到达停车参照后，按空格停稳。",
      "sha256": "7773a9ff7d402cc4ef9a3378b9b56d8437b1c8204ce79e2c3d43e271bd4a2f4d",
      "bytes": 182004,
      "duration": 11.268
    },
    "brake": {
      "file": "audio/minimax/brake-209059cee9fd.mp3",
      "text": "刹车。",
      "sha256": "931941aabeebefbfd2306653a53e933827544e830ffa1e88433f6640aa89ab8d",
      "bytes": 16692,
      "duration": 0.936
    },
    "exit_left": {
      "file": "audio/minimax/exit_left-50ff5c7094f1.mp3",
      "text": "换为前进，先直线驶出。车头和库口有足够空间后，再向左打方向，驶向 B 控制线。",
      "sha256": "f58424f9d05cc92447999831edc8ca845116b9708560c7396a7e9a28cd7e719f",
      "bytes": 156084,
      "duration": 9.648
    },
    "control_b": {
      "file": "audio/minimax/control_b-dd57b589ad79.mp3",
      "text": "确认两只前轮都越过 B 控制线，再停车准备倒车。接下来练习另一侧入库。",
      "sha256": "6dfc4a042c41dafc6a55b272ea55631b0d9524a716b2b628c2865bf1c3d53dae",
      "bytes": 134772,
      "duration": 8.316
    },
    "left_straight": {
      "file": "audio/minimax/left_straight-5b209bf850d8.mp3",
      "text": "从 B 端开始，保持方向回正，按住 S 慢速直倒。先认左镜里的车身和侧后地面，库线进入镜面后再比较间隙；接近模型参照时准备转向。",
      "sha256": "fe75059ff175c31b21bf26209225579d055cc7b382e53938b6ae1633fead5a3c",
      "bytes": 277044,
      "duration": 17.208
    },
    "left_turn": {
      "file": "audio/minimax/left_turn-523370df7e50.mp3",
      "text": "左打方向。",
      "sha256": "2f755277578e523c32d88e8c44e0dcfb8fb8a627b9d22e2ae0a7fa165a526e47",
      "bytes": 21876,
      "duration": 1.26
    },
    "left_align": {
      "file": "audio/minimax/left_align-fe80986ac669.mp3",
      "text": "保持当前转角，低速倒车。先认左镜中的车身和侧后地面，库角进入镜面后再比较间隙，兼顾右镜。",
      "sha256": "7d71577e6d9992c98507eddfaf9de0f1d85c8a68614702224728d2a706e7200b",
      "bytes": 192948,
      "duration": 11.952
    },
    "exit_right": {
      "file": "audio/minimax/exit_right-a4347e224d93.mp3",
      "text": "先直线前进驶出库口，留足空间后再向右打方向，返回 A 控制线。",
      "sha256": "8f3c74d451fc4a6690fd4c879fc03b0f92f9eca893d99f8804fdb60607df7588",
      "bytes": 128436,
      "duration": 7.92
    },
    "finish": {
      "file": "audio/minimax/finish-db29f2f483f5.mp3",
      "text": "完成两侧倒车入库，并返回 A 端。现在可以进入语音跟练，自己控制车辆，按照看镜、转向、回正的顺序练习。",
      "sha256": "a57c68c3f169d41527c722270671302dbe5adce5bd82f72ece041a721de0e069",
      "bytes": 198132,
      "duration": 12.276
    },
    "warning_line": {
      "file": "audio/minimax/warning_line-687e0e73534f.mp3",
      "text": "先按空格刹车。车身已触及场地边线，暂停观察，再复盘转向时机。",
      "sha256": "993369dfb15e6cee3cd9e4902951f46ea94e90db16e383b941d82812196f44ea",
      "bytes": 120948,
      "duration": 7.452
    },
    "warning_sequence": {
      "file": "audio/minimax/warning_sequence-94b51bbe0b19.mp3",
      "text": "本次倒车前，尚未确认两只前轮都越过指定控制线。请复盘起步位置和操作顺序。",
      "sha256": "f528357b7d53ee34cd720fc49a94eede49ef3e165f2f5c32e35d393268dd2ac2",
      "bytes": 148596,
      "duration": 9.18
    },
    "warning_time": {
      "file": "audio/minimax/warning_time-2b866212ed09.mp3",
      "text": "本次练习用时已超过二百一十秒。可以先完成观察和操作，再重练整套流程。",
      "sha256": "4fa4760885162799da63056749735b69ac43dc6d4fdef320ef83d67b44e03cda",
      "bytes": 131316,
      "duration": 8.1
    },
    "practice_intro": {
      "file": "audio/minimax/practice_intro-6d920eb57281.mp3",
      "text": "现在由你驾驶，语音会跟随车辆进度提示。W 前进，S 倒车，A 和 D 打方向，X 回正，空格刹车。Q 和 E 看左右镜，P 暂停观察。",
      "sha256": "e08d3d111cd7a138973849faa97df6bba8eed0e7af9348bbd67891edc14f8c50",
      "bytes": 285684,
      "duration": 17.748
    },
    "takeover_short": {
      "file": "audio/minimax/takeover_short-f47733a3d19c.mp3",
      "text": "现在由你操作，先看提示，准备好再继续。",
      "sha256": "98d16b305c137f77611c71094f9df8eb7e5059de84ca48784134f5b6e9442a07",
      "bytes": 76020,
      "duration": 4.644
    },
    "stopped": {
      "file": "audio/minimax/stopped-e1ba193407fb.mp3",
      "text": "车辆已在库内停稳。确认方向，接下来先直线前进，再按流程转向出库。",
      "sha256": "b8871d871a9e35250f7535a6f7f4c64c8a1ff9d7e70795dbbe53396fcef0ff21",
      "bytes": 138228,
      "duration": 8.532
    },
    "alignment_intro": {
      "file": "audio/minimax/alignment_intro-cfd57285d120.mp3",
      "text": "按住 S 慢速倒车，看镜判断车身与边线。接近平行时按 X，亲自体会回正所需的时间。",
      "sha256": "da553b0055852f6c6c6a357a4bb9e07f318197fdf2463ab328694de106cdfb6f",
      "bytes": 177396,
      "duration": 10.98
    },
    "alignment_early": {
      "file": "audio/minimax/alignment_early-b3d3d6110d03.mp3",
      "text": "这次回正偏早，车身仍带着入库角度。复盘镜中的车身和边线，下次稍晚一些开始回正。",
      "sha256": "187e98af9541bfc5ef7ced2f4cc2cc546bbd67853201dc17c4698fb4ebe53fe3",
      "bytes": 154932,
      "duration": 9.576
    },
    "alignment_late": {
      "file": "audio/minimax/alignment_late-2f095394802d.mp3",
      "text": "这次回正偏晚，车身已经转过平行方向。下次更早准备，给回正过程留出时间。",
      "sha256": "25a5682771169f052fdd1c70fbfa789c15813f0485c06ef787c1b6ec773fb2cb",
      "bytes": 145716,
      "duration": 9
    },
    "alignment_good": {
      "file": "audio/minimax/alignment_good-0ca119d1184c.mp3",
      "text": "这次回正后车身接近平行。继续通过左右镜比较间距，慢速完成后续入库。",
      "sha256": "a3b00a360219bd6e7d83e5c94c35a5d0cf2d1287ceeacecd0c9c32af4334080a",
      "bytes": 132468,
      "duration": 8.172
    },
    "beginner_mirror": {
      "file": "audio/minimax/beginner_mirror-e666105036a7.mp3",
      "text": "先认右后视镜，找到内侧的车身和侧后方地面。库线进入镜面后，再比较车身与库线的夹角和间隙。需要时点镜面教学放大。完成镜面辨认，再进入下一步。",
      "sha256": "e348e4ae41578c12efb151f8351f8627bb3766891a58377d0fac7338bfbf8bae",
      "bytes": 285108,
      "duration": 17.712
    },
    "beginner_turn": {
      "file": "audio/minimax/beginner_turn-a8a676001c67.mp3",
      "text": "现在只练向右打方向。按住 D，系统帮你低速倒车。观察右镜里的车身与库边位置怎样变化，方向到位会自动停住。",
      "sha256": "1ab730c8137d63f9544f4f818000afde2791aa4c9c2aedafc779c9ae2625676a",
      "bytes": 209652,
      "duration": 12.996
    },
    "beginner_hold": {
      "file": "audio/minimax/beginner_hold-a44a71e8f071.mp3",
      "text": "松开 D，方向会保持，不会自己回正。现在只按住 S 倒车，先认右镜里的车身和侧后地面；库线进入镜面后，再比较车身与库线的夹角，趋于平行时会自动停住。",
      "sha256": "7f09e8e2f2f499308f6e3a7a15f09c15ff6d4cacbee85a3bd1c7a98c605ea12d",
      "bytes": 290868,
      "duration": 18.072
    },
    "beginner_compare": {
      "file": "audio/minimax/beginner_compare-4a3368fd45ad.mp3",
      "text": "车已经停住。先认右镜里的车身和可见库线，再对照左镜。车身趋于平行时，要给回轮过程留出余量。完成两侧镜面辨认，再进入主动回正。",
      "sha256": "e2c40ac42e0bd464e8329aedfc346ff061c1f7907d74e64afe71e670753f7790",
      "bytes": 251700,
      "duration": 15.624
    },
    "beginner_center": {
      "file": "audio/minimax/beginner_center-9a6a8cccc444.mp3",
      "text": "现在按一次 X，把前轮回正。系统帮你保持低速，回正完成会自动停住。记住，松开方向键不等于回正。",
      "sha256": "d5996f0d3f4e0aa8edcbc52b13b57a0e1c7be8be3b15de4a92eef4b7415e0c14",
      "bytes": 193524,
      "duration": 11.988
    },
    "beginner_finish": {
      "file": "audio/minimax/beginner_finish-dc2492fe21cc.mp3",
      "text": "你已经体验了向右打方向、保持方向和主动回正。接下来练习自己判断回正时机，看完示范后亲手操作，再对照两侧镜面。",
      "sha256": "5916895cd217f09b61254fdd8a82a246ae6abad411b5c9398f473da1668aa728",
      "bytes": 251124,
      "duration": 15.588
    },
    "recovery_early": {
      "file": "audio/minimax/recovery_early-ffc392c7fc89.mp3",
      "text": "先刹车停稳。前轮虽然回正，车身仍有夹角。对照两侧镜面，再从回正前重练。",
      "sha256": "0e8da434ddd04a692c4618156b6a58ffa2ee9d43d13ba836535d83601e377588",
      "bytes": 157812,
      "duration": 9.756
    },
    "recovery_clearance": {
      "file": "audio/minimax/recovery_clearance-61ba3c8d6160.mp3",
      "text": "先刹车停稳。继续直倒可能碰线。看两侧车身与库线的间隙，暂停复盘，再从错误前重练。",
      "sha256": "5d9eb0642d890f0209a5fadbe151aceb721b226183a4cfbd99728749997eec00",
      "bytes": 164148,
      "duration": 10.152
    },
    "recovery_wrong_direction": {
      "file": "audio/minimax/recovery_wrong_direction-56a7b79fe257.mp3",
      "text": "先刹车停稳。这次转向与当前入库侧相反。核对左右镜和车尾方向，再重新练习。",
      "sha256": "f811f4d8aa45e4d5f308f1e1182750c9e9cb29ee57d98a460c89809514963ded",
      "bytes": 142836,
      "duration": 8.82
    },
    "judgment_ready": {
      "file": "audio/minimax/judgment_ready-dd59d51dd261.mp3",
      "text": "轮到你了。按住 S 慢慢倒车，看两面镜，自己选择什么时候按 X 回正。这一轮不会提前报操作口令。",
      "sha256": "128e64d5e8267267841aa1d99722651503595c0c85c421d209c0e89a31c06c1b",
      "bytes": 188340,
      "duration": 11.664
    },
    "alignment_missed": {
      "file": "audio/minimax/alignment_missed-38dfa46694fa.mp3",
      "text": "这一段还没有记录主动回正，车身已经摆过合适位置。先对照两组镜面，再从错过之前重练。",
      "sha256": "5b3f7f7df29479b6815961a4ed7b251fc9de03d08f92faa5a2399bebc36eb457",
      "bytes": 158388,
      "duration": 9.792
    },
    "correction_intro": {
      "file": "audio/minimax/correction_intro-868197cf4677.mp3",
      "text": "这次练车尾带小夹角入库。先认本车与库侧线。库口外沿不是库底，没有入镜的线不用找。看同一面镜的间隙走势，再核对另一侧，判断继续直倒时车尾会向哪侧逼线。两面镜的画面宽窄不能直接当成实际距离。系统辅助低速，你只练方向和主动回正。",
      "sha256": "966b3b56fa5a2319506a499d9762dac47805fd10917f14612eabfb596c622845",
      "bytes": 486132,
      "duration": 30.276
    },
    "correction_left_tight": {
      "file": "audio/minimax/correction_left_tight-146b57cbb433.mp3",
      "text": "这次车尾向左斜入。先看左镜，方向盘向右小幅转，让车尾走势逐渐向右调整。车头会向左外摆，留意前方，也要核对右镜。逼线趋势改善后主动回正；前轮回中不等于车身已直。",
      "sha256": "508b6d558cf301ffd5381f014d07a42e939ddafebf0409b6c7f02b2ec4ac707e",
      "bytes": 363444,
      "duration": 22.608
    },
    "correction_right_tight": {
      "file": "audio/minimax/correction_right_tight-506daf64b887.mp3",
      "text": "这次车尾向右斜入。先看右镜，方向盘向左小幅转，让车尾走势逐渐向左调整。车头会向右外摆，留意前方，也要核对左镜。逼线趋势改善后主动回正；前轮回中不等于车身已直。",
      "sha256": "b18ba23355423d62b30324d747b5ab281ede8522dfce217e23fee27d86355f3e",
      "bytes": 361716,
      "duration": 22.5
    },
    "correction_return": {
      "file": "audio/minimax/correction_return-cc9478b18eaf.mp3",
      "text": "余量已经改善，现在主动回正，再交替看两面镜，确认车身与库线的夹角。",
      "sha256": "a4f58ffe3285da5a4480962a9db2bdde301d5a6629af4e6a8ef0c196bae9ca8b",
      "bytes": 138228,
      "duration": 8.532
    },
    "correction_good": {
      "file": "audio/minimax/correction_good-d0556fa855a5.mp3",
      "text": "这次小幅纠偏后，直倒余量已有改善。对比同一面镜子的前后变化；前轮回正后，仍要核对车身姿态和另一侧余量。",
      "sha256": "e7f6b426fda355be921d8cdafc56c36fd47bce69f7662bf08c33c85cc83e87a1",
      "bytes": 215988,
      "duration": 13.392
    },
    "correction_retry": {
      "file": "audio/minimax/correction_retry-e77006f8f39e.mp3",
      "text": "先停住。重新辨认车身与库侧线，别把库口外沿当成库底。看车尾向哪边斜入，对照同一面镜里的变化，再从操作前重练。这题只练斜入纠偏，不是车身平行后的整体偏移。",
      "sha256": "1110cbc24e0274086ba29936669c2c03d3f7d9afc4c97efa42243bd0d92156e9",
      "bytes": 338676,
      "duration": 21.06
    },
    "course2_reverse_parking": {
      "file": "audio/minimax/course2_reverse_parking-51e869d3ea11.mp3",
      "text": "先确认前轮越过控制线，低速右倒库，车身快直时主动回正，全部入库后停稳。出库到另一端，再左倒库，最后回到起始端。镜内点位需按考试车和座椅校准，不照搬固定秒数。",
      "sha256": "4f92ab6a50046fd19a5c222a90aee1832f1fe17841e07b10ea4bf28b0c1169fe",
      "bytes": 349620,
      "duration": 21.744
    },
    "course2_hill_start": {
      "file": "audio/minimax/course2_hill_start-e8e40a65d524.mp3",
      "text": "一挡低速上坡，按本车校准参照控制与右边线的距离和停车位置。停稳后协调离合、加速与制动，建立驱动力再解除驻车制动，平稳起步，防止后溜和熄火。",
      "sha256": "1a79691b801a5bb455beee8941567a9a3e219f976a1fe232f74a1253d55f0088",
      "bytes": 291444,
      "duration": 18.108
    },
    "course2_side_parking": {
      "file": "audio/minimax/course2_side_parking-f9ed976f075a.mp3",
      "text": "驶到侧方车位前方停稳，换倒挡。先观察右镜和车尾走势，配合小幅调整倒入车位，车身顺直后回正并停稳。驶出前打左转向灯，确认左后方安全，再缓慢驶离，留意车头和后轮余量。",
      "sha256": "032553a42bb54e23f4e4606ed73e91618ff5c18d0814027f8ad6d31695107dab",
      "bytes": 354804,
      "duration": 22.068
    },
    "course2_curve_driving": {
      "file": "audio/minimax/course2_curve_driving-01f27cceba7a.mp3",
      "text": "低速进入曲线，视线向前看道路走向，兼顾两侧边线和后轮轨迹。转向要连续、适量，随着弯道逐步回轮和换向。车头进入下一弯不代表后轮已经过弯，避免只盯近处和猛打方向。",
      "sha256": "32b620437a73dd6d5de618799debfa5b042bed95ae4f94d0e6e87459ac0160dc",
      "bytes": 340404,
      "duration": 21.168
    },
    "course2_right_angle": {
      "file": "audio/minimax/course2_right_angle-16ba3557bf99.mp3",
      "text": "低速接近直角，先看出口方向，按本车标定参照开始转向。转弯中留意内侧后轮和外侧车头，确认车身逐渐通过拐角。接近出口方向时主动回轮，车身顺直后沿出口驶离。",
      "sha256": "6632654d26cadee01aa46b7a025efdc4789b0bd6ed24344146f8466fbe901a5a",
      "bytes": 332916,
      "duration": 20.7
    },
    "course3_prepare": {
      "file": "audio/minimax/course3_prepare-76dc39001c6a.mp3",
      "text": "上车前观察车辆四周和车底，检查车身、轮胎及周围风险。确认安全后上车，关好车门，调整座椅和后视镜，系好安全带，检查仪表、挡位与驻车制动。准备项目按当地考试设备要求完成。",
      "sha256": "93c6c60e23e7efc30c67b1e18d64c90d89f80269aaf2aa1c7a9cafdc4d858643",
      "bytes": 350772,
      "duration": 21.816
    },
    "course3_lights": {
      "file": "audio/minimax/course3_lights-16a722939372.mp3",
      "text": "车辆停稳后听完整指令，再操作灯光。照明良好、会车和近距离跟车用近光；照明不良且不影响他人时按需用远光。按场景交替远近光示意，故障难以移动时按规定示警。模拟结束按口令复位。",
      "sha256": "9a9d4e5487e264e164bb98bb5260dcb9544b1db099619bf0306db7fc2ae4efd2",
      "bytes": 388788,
      "duration": 24.192
    },
    "course3_start": {
      "file": "audio/minimax/course3_start-dd2cad8b005c.mp3",
      "text": "起步前检查挡位和制动，打左转向灯，观察左镜、左后方及前方，确认安全。踩离合挂一挡，协调离合与加速，解除驻车制动，平稳进入车道，车辆顺直后关闭转向灯。",
      "sha256": "93f805e5acf09cd90ee906b2d94a6302f3e234c52f0516960d1b7d44c8c2186e",
      "bytes": 335220,
      "duration": 20.844
    },
    "course3_straight": {
      "file": "audio/minimax/course3_straight-562986ccb774.mp3",
      "text": "视线放远，兼顾近处道路、左右后视镜和车速。保持车道内稳定行驶，按道路情况合理控制速度和挡位。发现偏移时小幅、及时修正，不死盯方向盘，也不要用大幅来回转向纠偏。",
      "sha256": "30dc4902246e304e959261ee66f4f3f8dcd6a06a0b68603924209d70c98b0551",
      "bytes": 345012,
      "duration": 21.456
    },
    "course3_gears": {
      "file": "audio/minimax/course3_gears-a859ac7c5949.mp3",
      "text": "根据路况和车速合理加减挡。换挡前确认条件，离合踩到底，按正确挡位路径操作，协调离合和加速使车辆平顺。减速后选择匹配挡位，不低头找挡，也不机械追求统一换挡时速。",
      "sha256": "f778b5c699f83a98f8196f594e7e6620e9373c76f2160c937c6d6a019607bd2e",
      "bytes": 339252,
      "duration": 21.096
    },
    "course3_lane_change": {
      "file": "audio/minimax/course3_lane_change-d976f38ad0ba.mp3",
      "text": "先观察目标车道和后方，打转向灯，确认安全并留足信号提示时间后，小幅平顺变道。进入目标车道后回正并关闭转向灯。每次只完成一条车道的变更，不连续横跨多条车道。",
      "sha256": "8a20002adfedd9da6940d7295bb054d41455633758877866235dde85a93f51b9",
      "bytes": 320244,
      "duration": 19.908
    },
    "course3_intersection": {
      "file": "audio/minimax/course3_intersection-f1b496f3a383.mp3",
      "text": "提前观察交通信号、标志标线、路口两侧和行人，合理减速，按通行规则进入。绿灯也要确认路口可以安全通过，不抢黄灯、不闯红灯，不在拥堵时贸然驶入路口。通过后继续观察。",
      "sha256": "4a5c2f521be4dd530a2857c2061cabd8747f65728cb3aa5ad2b2727a3fbd5d52",
      "bytes": 331188,
      "duration": 20.592
    },
    "course3_left_turn": {
      "file": "audio/minimax/course3_left_turn-8dd5fdfa80b7.mp3",
      "text": "提前进入合适车道，打左转向灯，观察信号、对向车辆、左右道路和行人。确认安全后低速转弯，按标线进入正确车道，不切入对向。车身转向出口后逐渐回正，完成转弯再关闭转向灯。",
      "sha256": "edb4414a8e9521ea5163bc7679db670f37afd2238921a9b707134056964eda35",
      "bytes": 349044,
      "duration": 21.708
    },
    "course3_right_turn": {
      "file": "audio/minimax/course3_right_turn-b4da1b6c060d.mp3",
      "text": "提前打右转向灯，减速观察信号、右侧非机动车、行人与转弯出口。允许右转也不代表优先通行，先让冲突交通通过，再低速转入正确车道，留意右侧后轮轨迹，顺直后关灯。",
      "sha256": "13646dd6e94e503f9122bba9f6865e8947b131b3fe1aa177a3470ee1064b8e8d",
      "bytes": 316788,
      "duration": 19.692
    },
    "course3_crosswalk": {
      "file": "audio/minimax/course3_crosswalk-319272ab3b13.mp3",
      "text": "提前识别人行横道，减速观察两侧和被遮挡区域。遇行人正在通过时，在停止线前停稳让行，不能催促或绕行抢过。确认行人安全通过、前方畅通后再平稳起步，并继续留意新的行人。",
      "sha256": "e1407ba892a1d98ee1ff1885318d046e7b506e3c2d5b7719f86671baab66d4eb",
      "bytes": 334068,
      "duration": 20.772
    },
    "course3_school": {
      "file": "audio/minimax/course3_school-4347805d6895.mp3",
      "text": "提前识别学校区域，减速并提高观察频率，留意儿童、接送车辆和遮挡处。保持足够空间，随时准备停车让行，不能以没有语音提示或暂时看不到行人为由忽略学校区域。",
      "sha256": "c6324789d6bffda6c3643e20f7ba5ce951812c9715ecc579293193e318c2a1c0",
      "bytes": 294324,
      "duration": 18.288
    },
    "course3_bus": {
      "file": "audio/minimax/course3_bus-48d38b05760a.mp3",
      "text": "提前识别公交站并减速，观察公交车起步、上下车乘客和车前车后的遮挡区域。留足侧向空间，必要时停车让行，不与起步公交车争道，也不从其盲区内贸然加速通过。",
      "sha256": "db048f4356a239225ed17ef1c78e51acd4cb927b5643f095e7dad97fb3d70319",
      "bytes": 305844,
      "duration": 19.008
    },
    "course3_meeting": {
      "file": "audio/minimax/course3_meeting-ca6c0cb24e55.mp3",
      "text": "观察对向车辆、道路宽度及两侧空间，合理控制车速和车道位置，保持安全横向间距。道路狭窄或有障碍时，按规则提前让行，不抢道；会车时仍要留意本侧路边行人和非机动车。",
      "sha256": "cad05efe7617f9d69841d86ec393555d78461b6540b61eeb9408b881e54a25f4",
      "bytes": 326004,
      "duration": 20.268
    },
    "course3_overtake": {
      "file": "audio/minimax/course3_overtake-5f4b3edcb2af.mp3",
      "text": "先判断是否允许超车，再观察前方和左后方，打左转向灯并确认安全。平顺驶入左侧同向车道，保持足够横向间距通过前车。与被超车辆拉开安全距离后，观察右后方，打右灯再返回。",
      "sha256": "33c59f6621080feee1565a7868bdf54624b1fad30a5752dd8225e6f8d6bf0c81",
      "bytes": 328884,
      "duration": 20.448
    },
    "course3_uturn": {
      "file": "audio/minimax/course3_uturn-d03431811060.mp3",
      "text": "提前选择允许掉头且空间充足的位置，打左转向灯，减速观察对向车、行人与非机动车。确认安全后低速掉头，持续核对车头外摆和后轮轨迹，进入正确返回车道，顺直后关灯。",
      "sha256": "6b66d5cb6fed6e96b1bee80bbec4f3a4fc4d1990504e072ad332bb75046fabab",
      "bytes": 343860,
      "duration": 21.384
    },
    "course3_night": {
      "file": "audio/minimax/course3_night-0abdfcfa8f0a.mp3",
      "text": "夜间按照明和交通条件正确使用灯光，控制在可安全停车的视距内行驶。接近对向车辆及时改近光，避免眩目；通过需示意的路段按规定交替灯光，并持续观察行人与路侧。没有夜间实考时另做模拟灯光。",
      "sha256": "7c9b1612a9401713e5a5f20d1796c45177bb952cd44b839e1f720663a32988f9",
      "bytes": 383604,
      "duration": 23.868
    },
    "course3_pull_over": {
      "file": "audio/minimax/course3_pull_over-8fa95299f671.mp3",
      "text": "听到停车指令后，先观察右镜、右后方和路边条件，打右转向灯，选择允许停车的位置，减速平顺靠边。停稳后按要求操作挡位和驻车制动，关闭转向灯。结束下车前再次观察侧后方，确认安全再开门。",
      "sha256": "f02e7024d2319d6d0f87638fe4af8270540a451f426ae5b20fa4ac5ed97c2c5c",
      "bytes": 391092,
      "duration": 24.336
    }
  }
}
